{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "Bundler",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "esModuleInterop": true,
    "types": ["cypress-commands", "cypress"],
    "paths": {
      "support/*": ["./cypress/support/*"]
    }
  },
  "include": ["**/*.ts"]
}
