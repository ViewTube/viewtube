{
  "name": "@viewtube/server",
  "main": "dist/main",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.12"
  },
  "scripts": {
    "serve": "nest start -w",
    "dev": "pnpm run serve",
    "build": "cross-env NODE_ENV=production nest build",
    "start": "cross-env NODE_ENV=production node ./dist/main.js",
    "gen:swagger": "pnpm run build && cross-env GENERATE_SWAGGER=true node ./dist/main.js",
    "gen:api": "pnpm run gen:swagger && openapi-typescript swagger-spec.json --output ../shared/src/api.schema.ts && rimraf swagger-spec.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bull": "11.0.5",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@types/sanitize-html": "2.16.1",
    "@viewtube/shared": "workspace:*",
    "archiver": "8.0.0",
    "axios": "1.19.0",
    "bcryptjs": "3.0.3",
    "bull": "4.16.5",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "cron": "4.4.0",
    "cron-time-generator": "2.0.3",
    "dayjs": "1.11.23",
    "destr": "2.0.5",
    "fast-xml-parser": "5.11.0",
    "fastify": "5.12.1",
    "fetch-socks": "1.3.3",
    "https-proxy-agent": "9.1.0",
    "humanize-duration": "3.34.1",
    "ioredis": "5.10.1",
