    "web-push": "3.6.7",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0",
    "youtubei.js": "14.0.0",
    "ytpl": "2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/websockets": "11.1.3",
    "@swc/cli": "0.7.7",
    "@swc/core": "1.12.5",
    "@types/archiver": "6.0.3",
    "@types/cookie-parser": "1.4.9",
