{
  "name": "@viewtube/server",
  "main": "dist/main",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.12"
  },
  "scripts": {
    "serve": "nest start -w",
    "dev": "pnpm run serve",
    "build": "cross-env NODE_ENV=production nest build",
    "start": "cross-env NODE_ENV=production node ./dist/main.js",
    "gen:swagger": "pnpm run build && cross-env GENERATE_SWAGGER=true node ./dist/main.js",
    "gen:api": "pnpm run gen:swagger && openapi-typescript swagger-spec.json --output ../shared/src/api.schema.ts && rimraf swagger-spec.json"
  },
  "_moduleAliases": {
    "server": "dist/server"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.3",
    "@fastify/static": "8.2.0",
    "@fastify/swagger": "9.5.1",
    "@keyv/redis": "^4.4.1",
    "@nestjs/bull": "11.0.2",
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.1.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mongoose": "11.0.3",
    "@nestjs/platform-fastify": "11.1.3",
    "@nestjs/schedule": "6.0.0",
    "@nestjs/swagger": "11.2.0",
    "@types/sanitize-html": "2.16.0",
    "@viewtube/shared": "workspace:*",
    "archiver": "7.0.1",
    "axios": "1.10.0",
    "bcryptjs": "3.0.2",
    "bull": "4.16.5",
    "cache-manager": "7.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "cron": "4.3.1",
    "cron-time-generator": "2.0.3",
    "dayjs": "1.11.13",
    "destr": "2.0.5",
    "fast-xml-parser": "5.2.5",
    "fastify": "5.4.0",
    "fetch-socks": "1.3.2",
    "https-proxy-agent": "7.0.6",
    "humanize-duration": "3.33.0",
    "ioredis": "5.6.1",
    "joi": "17.13.3",
    "mini-svg-data-uri": "1.4.4",
    "mongoose": "8.16.0",
    "nest-winston": "1.10.2",
